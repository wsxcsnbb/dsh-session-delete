{
  "name": "dsh-session-delete",
  "version": "0.1.0",
  "private": true,
  "description": "Permanent Session deletion: a Delete row in the Session row's \"...\" menu that removes the Session from the Workspace registry, the live stores, and the JSONL persistence root.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "license": "MIT"
}
